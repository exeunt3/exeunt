
---
import Base from "../layouts/Base.astro";
const all = await Astro.glob('../content/essays/*.md');
const essays = all.sort((a,b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---
<Base title="Exeunt — Open Transmissions">
  <h1>Open Transmissions</h1>
  <section class="essay-list">
    {essays.map(({url, frontmatter}) => (
      <article class="card">
        <div class="thumb">
          {frontmatter.banner && <img src={frontmatter.banner} alt="" />}
        </div>
        <h2><a href={url}>{frontmatter.title}</a></h2>
        <p>{frontmatter.summary}</p>
      </article>
    ))}
  </section>
</Base>
